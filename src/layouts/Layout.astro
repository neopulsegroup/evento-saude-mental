---
import "../styles/global.css";
import { SITE, FAQ } from "../lib/site";

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(SITE.ogImage, SITE.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Event",
    name: SITE.shortName,
    description: SITE.description,
    startDate: SITE.startDate,
    endDate: SITE.endDate,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    inLanguage: "pt-BR",
    image: [ogImage],
    location: {
      "@type": "Place",
      name: SITE.venue,
      address: { "@type": "PostalAddress", streetAddress: `${SITE.street}, ${SITE.district}`, postalCode: SITE.postalCode, addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: SITE.country },
    },
    organizer: { "@type": "Organization", name: "Oporto Forte Group", url: "https://oportoforte.com" },
    offers: { "@type": "Offer", url: canonical, availability: "https://schema.org/InStock", price: "0", priceCurrency: "BRL" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Oporto Forte Group",
    url: "https://oportoforte.com",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#061438" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Oporto Forte Group" />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={SITE.title} />
    <meta name="twitter:description" content={SITE.description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded focus:bg-white focus:px-3 focus:py-2">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
