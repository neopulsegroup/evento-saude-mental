---
const { class: cls = "" } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`} aria-label="OFG — Oporto Forte Group">
  <svg width="40" height="40" viewBox="0 0 64 64" aria-hidden="true">
    <defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6fd6ff"/><stop offset="1" stop-color="#1457d9"/></linearGradient></defs>
    <circle cx="32" cy="32" r="28" fill="url(#lg)"/>
    <path d="M6 24h52M5 32h54M7 40h50M12 48h40" stroke="#fff" stroke-opacity=".75" stroke-width="2.5"/>
  </svg>
  <span class="leading-none">
    <span class="font-display block text-[28px] font-extrabold tracking-tight text-white">OFG</span>
    <span class="block text-[8px] font-medium text-white/80">Oporto Forte Group</span>
  </span>
</span>
