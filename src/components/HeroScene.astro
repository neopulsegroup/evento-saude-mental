---
// Illustrated conference scene: stage lights, projection screen, speaker and audience silhouettes.
import { rng } from "../lib/rng";
const r = rng(7);
const W = 1600, H = 900;

const bokeh = Array.from({ length: 34 }, () => ({
  x: 700 + r() * 900, y: 20 + r() * 330, r: 6 + r() * 26,
  o: 0.12 + r() * 0.5, c: r() > 0.55 ? "#7fd0ff" : r() > 0.5 ? "#ffd9a0" : "#4aa0ff",
}));

// Audience rows: back (small, dim) to front (large, dark). Heads are ellipses, shoulders are rounded paths.
const rows = [
  { y: 520, s: 0.55, n: 26, fill: "#0b2a63", op: 0.9 },
  { y: 590, s: 0.75, n: 20, fill: "#09224f", op: 0.95 },
  { y: 680, s: 1.0, n: 15, fill: "#071a3d", op: 1 },
  { y: 790, s: 1.35, n: 11, fill: "#050f28", op: 1 },
  { y: 920, s: 1.9, n: 7, fill: "#030a1c", op: 1 },
].map((row, i) => {
  const step = W / row.n;
  const people = Array.from({ length: row.n + 1 }, (_, k) => ({
    x: k * step + (r() - 0.5) * step * 0.5 + (i % 2 ? step / 2 : 0),
    dy: (r() - 0.5) * 14 * row.s,
    hs: 0.85 + r() * 0.3,
    tilt: (r() - 0.5) * 6,
  }));
  return { ...row, people };
});
---
<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" class="h-full w-full" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hs-bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#06143a" /><stop offset=".6" stop-color="#0a2a6b" /><stop offset="1" stop-color="#0f4fb0" /></linearGradient>
    <radialGradient id="hs-glow" cx=".78" cy=".3" r=".55"><stop offset="0" stop-color="#6cc4ff" stop-opacity=".65" /><stop offset="1" stop-color="#6cc4ff" stop-opacity="0" /></radialGradient>
    <linearGradient id="hs-screen" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#bfe6ff" /><stop offset="1" stop-color="#4f9bff" /></linearGradient>
    <filter id="hs-blur"><feGaussianBlur stdDeviation="9" /></filter>
    <filter id="hs-blur-s"><feGaussianBlur stdDeviation="2.2" /></filter>
    <linearGradient id="hs-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#030a1c" stop-opacity="0" /><stop offset="1" stop-color="#030a1c" stop-opacity=".85" /></linearGradient>
  </defs>
  <rect width={W} height={H} fill="url(#hs-bg)" />
  <rect width={W} height={H} fill="url(#hs-glow)" />

  <!-- light beams -->
  <g opacity=".35" filter="url(#hs-blur)">
    <polygon points="1180,0 1260,0 1020,520 900,520" fill="#9fdcff" />
    <polygon points="1420,0 1500,0 1500,520 1280,520" fill="#9fdcff" />
  </g>

  <!-- bokeh -->
  <g filter="url(#hs-blur-s)">
    {bokeh.map((b) => <circle cx={b.x} cy={b.y} r={b.r} fill={b.c} opacity={b.o} />)}
  </g>

  <!-- screen -->
  <g>
    <rect x="1290" y="150" width="260" height="165" rx="6" fill="url(#hs-screen)" opacity=".95" />
    <rect x="1290" y="150" width="260" height="165" rx="6" fill="none" stroke="#fff" stroke-opacity=".5" />
    <rect x="1316" y="180" width="110" height="10" rx="5" fill="#0a2a6b" opacity=".6" />
    <rect x="1316" y="202" width="170" height="7" rx="3.5" fill="#0a2a6b" opacity=".35" />
    <rect x="1316" y="218" width="150" height="7" rx="3.5" fill="#0a2a6b" opacity=".35" />
    <g fill="#0a2a6b" opacity=".55"><rect x="1450" y="250" width="18" height="40" /><rect x="1474" y="236" width="18" height="54" /><rect x="1498" y="222" width="18" height="68" /></g>
  </g>

  <!-- speaker -->
  <g transform="translate(1160 270)">
    <ellipse cx="0" cy="248" rx="70" ry="10" fill="#9fdcff" opacity=".22" />
    <circle cx="0" cy="22" r="17" fill="#0a1d46" />
    <path d="M-34 66 Q-34 42 0 42 Q34 42 34 66 L30 190 L-30 190 Z" fill="#0a1d46" />
    <path d="M-30 190 L-32 246 L-8 246 L0 200 L8 246 L32 246 L30 190 Z" fill="#0a1d46" />
    <path d="M-34 66 Q-34 42 0 42" stroke="#9fdcff" stroke-opacity=".6" stroke-width="2" fill="none" />
  </g>

  <!-- audience -->
  {rows.map((row) => (
    <g opacity={row.op}>
      {row.people.map((p) => (
        <g transform={`translate(${p.x} ${row.y + p.dy}) rotate(${p.tilt}) scale(${row.s * p.hs})`}>
          <ellipse cx="0" cy="-58" rx="22" ry="27" fill={row.fill} />
          <path d="M-62 40 Q-62 -18 0 -22 Q62 -18 62 40 L62 120 L-62 120 Z" fill={row.fill} />
          <path d="M-22 -80 Q0 -92 22 -80" stroke="#7fd0ff" stroke-opacity=".28" stroke-width="2.5" fill="none" />
        </g>
      ))}
    </g>
  ))}
  <rect y="450" width={W} height="450" fill="url(#hs-fade)" />
</svg>
