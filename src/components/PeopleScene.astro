---
// Illustrated close-up of two attendees against warm blurred event lights.
import { rng } from "../lib/rng";
const r = rng(21);
const bokeh = Array.from({ length: 22 }, () => ({
  x: r() * 800, y: r() * 560, r: 14 + r() * 46, o: 0.1 + r() * 0.4,
  c: r() > 0.5 ? "#ffcf8a" : r() > 0.4 ? "#8fd0ff" : "#ffb36b",
}));
---
<svg viewBox="0 0 800 1000" preserveAspectRatio="xMidYMid slice" class="h-full w-full" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ps-bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b2a22" /><stop offset=".5" stop-color="#1c2b4d" /><stop offset="1" stop-color="#0a1736" /></linearGradient>
    <filter id="ps-blur"><feGaussianBlur stdDeviation="14" /></filter>
    <linearGradient id="ps-skin" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f1b99a" /><stop offset="1" stop-color="#c98160" /></linearGradient>
    <linearGradient id="ps-skin2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e3a98a" /><stop offset="1" stop-color="#b8734f" /></linearGradient>
    <linearGradient id="ps-fade" x1="0" y1="0" x2="0" y2="1"><stop offset=".55" stop-color="#030a1c" stop-opacity="0" /><stop offset="1" stop-color="#030a1c" stop-opacity=".7" /></linearGradient>
  </defs>
  <rect width="800" height="1000" fill="url(#ps-bg)" />
  <g filter="url(#ps-blur)">{bokeh.map((b) => <circle cx={b.x} cy={b.y} r={b.r} fill={b.c} opacity={b.o} />)}</g>

  <!-- back person (man, suit) -->
  <g transform="translate(250 330)">
    <path d="M-150 700 Q-150 190 0 170 Q150 190 150 700 Z" fill="#12203f" />
    <path d="M-40 175 L0 330 L40 175 Z" fill="#e9eef8" />
    <path d="M-6 215 L6 215 L10 330 L0 345 L-10 330 Z" fill="#2a6fd6" />
    <rect x="-34" y="120" width="68" height="64" rx="28" fill="url(#ps-skin2)" />
    <ellipse cx="0" cy="40" rx="78" ry="96" fill="url(#ps-skin2)" />
    <path d="M-80 30 Q-76 -78 0 -84 Q76 -78 80 30 Q56 -22 0 -22 Q-56 -22 -80 30 Z" fill="#17141a" />
    <path d="M-44 70 Q0 118 44 70 Q0 96 -44 70 Z" fill="#fff" opacity=".9" />
  </g>

  <!-- front person (woman, long hair, blazer, lanyard) -->
  <g transform="translate(540 400)">
    <path d="M-120 440 Q-130 -60 0 -80 Q130 -60 120 440 Z" fill="#2a1a16" />
    <path d="M-200 720 Q-210 200 0 180 Q210 200 200 720 Z" fill="#c9a98c" />
    <path d="M-48 190 L0 360 L48 190 Z" fill="#f4f0ea" />
    <path d="M-30 195 L-6 420" stroke="#2a6fd6" stroke-width="7" />
    <path d="M30 195 L6 420" stroke="#2a6fd6" stroke-width="7" />
    <rect x="-34" y="410" width="68" height="90" rx="8" fill="#fff" />
    <rect x="-24" y="424" width="48" height="8" rx="4" fill="#2a6fd6" />
    <rect x="-38" y="130" width="76" height="76" rx="30" fill="url(#ps-skin)" />
    <ellipse cx="0" cy="50" rx="90" ry="108" fill="url(#ps-skin)" />
    <path d="M-96 60 Q-110 -100 0 -104 Q110 -100 96 60 Q86 -34 20 -44 Q-40 -54 -70 -6 Q-84 20 -96 60 Z" fill="#2a1a16" />
    <path d="M-52 92 Q0 150 52 92 Q0 124 -52 92 Z" fill="#fff" />
    <path d="M-58 36 Q-40 26 -22 36 M22 36 Q40 26 58 36" stroke="#2a1a16" stroke-width="5" stroke-linecap="round" fill="none" />
  </g>
  <rect width="800" height="1000" fill="url(#ps-fade)" />
</svg>
